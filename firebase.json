{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "modulo-squares-prod",
          "appId": "1:253948321735:android:f947b74aee2ce4a79ec3e2",
          "fileOutput": "packages/mobile/android/app/google-services.prod.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "modulo-squares-prod",
          "appId": "1:253948321735:ios:527c4e69b233a2199ec3e2",
          "uploadDebugSymbols": false,
          "fileOutput": "packages/mobile/ios/Runner/GoogleService-Info.prod.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "modulo-squares-prod",
          "configurations": {
            "android": "1:253948321735:android:f947b74aee2ce4a79ec3e2",
            "ios": "1:253948321735:ios:527c4e69b233a2199ec3e2",
            "web": "1:253948321735:web:0f7df38ef2e47fe89ec3e2"
          }
        }
      }
    }
  },
  "functions": {
    "source": "packages/functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "rules": "packages/firestore-rules/firestore.rules"
  },
  "emulators": {
    "dataconnect": {
      "dataDir": "dataconnect/.dataconnect/pgliteData"
    }
  },
  "hosting": {
    "target": "website",
    "public": "packages/web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "!**/.well-known",
      "!**/.well-known/**",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          },
          {
            "key": "Expires",
            "value": "0"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://nelsongrey.com/games/modulo-squares/",
        "type": 301
      },
      {
        "source": "/how-it-works",
        "destination": "https://nelsongrey.com/games/modulo-squares/how-to-play",
        "type": 301
      },
      {
        "source": "/download",
        "destination": "https://nelsongrey.com/games/modulo-squares/",
        "type": 301
      },
      {
        "source": "/pricing",
        "destination": "https://nelsongrey.com/games/modulo-squares/",
        "type": 301
      },
      {
        "source": "/leaderboard",
        "destination": "https://nelsongrey.com/games/modulo-squares/",
        "type": 301
      },
      {
        "source": "/strategy-guide",
        "destination": "https://nelsongrey.com/games/modulo-squares/strategy-guide",
        "type": 301
      },
      {
        "source": "/modular-arithmetic-explained",
        "destination": "https://nelsongrey.com/games/modulo-squares/modular-arithmetic-explained",
        "type": 301
      },
      {
        "source": "/privacy",
        "destination": "https://nelsongrey.com/games/modulo-squares/privacy",
        "type": 301
      },
      {
        "source": "/terms",
        "destination": "https://nelsongrey.com/games/modulo-squares/terms",
        "type": 301
      },
      {
        "source": "/cookies",
        "destination": "https://nelsongrey.com/games/modulo-squares/cookies",
        "type": 301
      },
      {
        "source": "/support",
        "destination": "https://nelsongrey.com/games/modulo-squares/support",
        "type": 301
      },
      {
        "regex": "^/[^.]*$",
        "destination": "https://nelsongrey.com/games/modulo-squares/",
        "type": 301
      }
    ]
  }
}

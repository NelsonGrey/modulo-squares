# Zero-touch DevOps: Disable interactive prompts
ENV["FASTLANE_SKIP_UPDATE_CHECK"] = "1"
ENV["FASTLANE_HIDE_CHANGELOG"] = "1"

default_platform(:android)

platform :android do
  desc "Upload an already-built .aab to the Play Console internal testing track"
  lane :internal do |options|
    aab_path = options[:aab_path] || "../build/app/outputs/bundle/release/app-release.aab"
    UI.user_error!("AAB not found at #{aab_path}") unless File.exist?(aab_path)

    upload_to_play_store(
      track: "internal",
      aab: aab_path,
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      json_key_data: ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"],
      package_name: "com.modulosquares.app.android"
    )

    UI.success("✅ Uploaded to Play Console internal testing track")
  end

  desc "Promote the current internal testing release to production"
  lane :promote_to_production do |options|
    rollout = options[:rollout] || "1.0"

    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      rollout: rollout,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      json_key_data: ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"],
      package_name: "com.modulosquares.app.android"
    )

    UI.success("✅ Promoted internal release to production (rollout: #{rollout})")
  end
end

{
  "name": "@shared/firestore-rules",
  "version": "1.0.0",
  "description": "Firestore security rules and emulator-backed tests for Modulo Squares",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-modulo-squares-rules-test \"vitest run\"",
    "test:watch": "firebase emulators:exec --only firestore --project demo-modulo-squares-rules-test \"vitest\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.5.0",
    "firebase": "^12.18.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}

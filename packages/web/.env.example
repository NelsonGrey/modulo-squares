# Modulo Squares promo website — environment variables
#
# Local dev: copy relevant lines into `packages/web/.env` (git-ignored).
# CI (.github/workflows/ci-cd.yml -> build-web) regenerates
# `packages/web/.env.production` for the target environment at build time, so
# the committed `.env.production` only needs to be a working prod fallback.

# development | staging | production
# Drives EnvironmentGate: staging/development web deployments require a Google
# sign-in from an allowlisted email; production and localhost never gate.
VITE_ENVIRONMENT=development

# Firebase web config (public by design; guarded by Firestore rules + App Check)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# EnvironmentGate allowlist (dev/staging only). Comma-separated.
# These are NOT server secrets — like every VITE_* var they end up readable
# in the deployed JS bundle. The gate is a low-friction "keep the public out
# of our staging site" fence, not an auth boundary. Still, don't commit real
# addresses: in CI they come from the repo secrets
# VITE_ALLOWED_EMAILS_{DEVELOPMENT,STAGING} /
# VITE_ALLOWED_EMAIL_DOMAINS_{DEVELOPMENT,STAGING}. Blank => gate fails closed.
VITE_ALLOWED_EMAILS=
VITE_ALLOWED_EMAIL_DOMAINS=

# Show the "coming soon" splash instead of the site
VITE_SHOW_COMING_SOON=false

# Google AdSense — leave a slot blank to disable it
VITE_ADSENSE_PUBLISHER_ID=
VITE_ADSENSE_SLOT_BELOW_HEADER=
VITE_ADSENSE_SLOT_ABOVE_FOOTER=
